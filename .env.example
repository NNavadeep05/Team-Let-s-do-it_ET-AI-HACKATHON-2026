# core
ENV=dev
SECRET_KEY=neuron-secret-key-12345
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
CORS=http://localhost:5173

# postgres
POSTGRES_USER=neuron
POSTGRES_PASSWORD=neuronpass
POSTGRES_DB=neuron
DATABASE_URL=postgresql+asyncpg://neuron:neuronpass@postgres:5432/neuron

# neo4j
NEO4J_AUTH=neo4j/neuronpass
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neuronpass

# qdrant / redis / minio
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=neuron-iq
MINIO_SECURE=false

# llm
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PRIMARY=gemini-2.0-flash
LLM_HEAVY=gemini-2.0-pro
EMBED_MODEL=text-embedding-3-large
